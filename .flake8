[flake8]
# 代码按约 120 列手写（不用自动格式化器重排）
max-line-length = 120
extend-ignore = E203, W503
exclude = .git, .venv, __pycache__, build, dist, .mypy_cache, .pytest_cache
# pytest 夹具按名字导入后作为测试参数使用，flake8 把参数名视为对导入名的重定义（F811）
per-file-ignores =
    tests/unit/test_distributed_mesh_loader.py: F811
    tests/unit/test_distributed_mesh_loader_dual_time.py: F811
    tests/unit/test_distributed_mesh_loader_sst.py: F811
    tests/unit/test_gpu_distributed_sa.py: F811
